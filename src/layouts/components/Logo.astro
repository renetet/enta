---
import config from "@/config/config.json";
const { src } = Astro.props;
const {
  logo,
  logo_width,
  logo_height,
  logo_text,
  title,
}: {
  logo: string;
  logo_width: any;
  logo_height: any;
  logo_text: string;
  title: string;
} = config.site;
const logoSrc = src ? src : `${logo}?v=5`;
---

<a href="/" class="navbar-brand block">
  {
    src || logo ? (
      <img
        width={logo_width.replace("px", "")}
        height={logo_height.replace("px", "")}
        src={logoSrc}
        alt={title}
        style={{
          height: logo_height.replace("px", "") + "px",
          width: logo_width.replace("px", "") + "px",
        }}
      />
    ) : logo_text ? (
      logo_text
    ) : (
      title
    )
  }
</a>
