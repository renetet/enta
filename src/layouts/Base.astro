---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import i18n from "@/config/i18n.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/layouts/partials/Footer.astro";
import Header from "@/layouts/partials/Header.astro";
import "@/styles/main.css";
import { AstroFont } from "astro-font";

// font families
const pf = theme.fonts.font_family.primary;
const sf = theme.fonts.font_family.secondary;

let fontPrimary, fontSecondary;
if (theme.fonts.font_family.primary) {
  fontPrimary = theme.fonts.font_family.primary
    .replace(/\+/g, " ")
    .replace(/:[ital,]*[ital@]*[wght@]*[0-9,;]+/gi, "");
}
if (theme.fonts.font_family.secondary) {
  fontSecondary = theme.fonts.font_family.secondary
    .replace(/\+/g, " ")
    .replace(/:[ital,]*[ital@]*[wght@]*[0-9,;]+/gi, "");
}

// types for frontmatters
export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
}

// distructure frontmatters
const { title, meta_title, description, image, noindex, canonical } =
  Astro.props;
const urlLang = Astro.url.searchParams.get("lang");
const englishPaths = ["/contact", "/free-resources", "/thank-you"];
const lang = urlLang === "en" || englishPaths.includes(Astro.url.pathname) ? "en" : "de";
const translations = i18n[lang];
const baseUrl = config.site.base_url.replace(/\/$/, "");
const currentPath = Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");
const canonicalUrl = canonical || `${baseUrl}${currentPath}`;
const rawTitle = plainify(meta_title ? meta_title : title ? title : translations.meta.title || config.site.title);
const seoTitle = rawTitle.toLowerCase().includes("enta.at") ? rawTitle : `${rawTitle} | enta.at`;
const seoDescription = plainify(description ? description : translations.meta.description || config.metadata.meta_description);
const socialImage = `${baseUrl}${image ? image : config.metadata.meta_image}`;
const alternateRoutes: Record<string, { de: string; en: string }> = {
  "/kontakt": { de: "/kontakt", en: "/contact" },
  "/contact": { de: "/kontakt", en: "/contact" },
  "/ressourcen": { de: "/ressourcen", en: "/free-resources" },
  "/free-resources": { de: "/ressourcen", en: "/free-resources" },
};
const alternates = alternateRoutes[currentPath];
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${baseUrl}/#organization`,
  name: "ENTA AI Automation",
  url: baseUrl,
  logo: `${baseUrl}/images/logo-aia.svg`,
  image: socialImage,
  email: "info@enta.at",
  description: translations.meta.description,
  address: { "@type": "PostalAddress", addressLocality: "Wien", addressCountry: "AT" },
  areaServed: [{ "@type": "City", name: "Wien" }, { "@type": "Country", name: "Österreich" }],
  knowsAbout: ["AI Automation", "n8n", "Workflow Automation", "EU-hosted LLMs"],
};
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: seoTitle,
  description: seoDescription,
  inLanguage: lang === "en" ? "en-AT" : "de-AT",
  isPartOf: { "@id": `${baseUrl}/#website` },
  about: { "@id": `${baseUrl}/#organization` },
};
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${baseUrl}/#website`,
  url: baseUrl,
  name: "enta.at",
  publisher: { "@id": `${baseUrl}/#organization` },
  inLanguage: ["de-AT", "en-AT"],
};
const breadcrumbSchema = currentPath === "/" ? null : {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: lang === "en" ? "Home" : "Start", item: `${baseUrl}/` },
    { "@type": "ListItem", position: 2, name: rawTitle, item: canonicalUrl },
  ],
};
const servicePaths = ["/automation", "/services", "/pricing"];
const serviceSchema = servicePaths.includes(currentPath) ? {
  "@context": "https://schema.org",
  "@type": "Service",
  name: rawTitle,
  description: seoDescription,
  url: canonicalUrl,
  serviceType: "AI and workflow automation",
  provider: { "@id": `${baseUrl}/#organization` },
  areaServed: { "@type": "City", name: "Wien" },
} : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- favicon -->
    <link rel="shortcut icon" href={config.site.favicon} />
    <!-- theme meta -->
    <meta name="theme-name" content="ENTA-light-astro" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <!-- google font css -->
    <AstroFont
      config={[
        {
          src: [],
          preload: false,
          display: "swap",
          name: fontPrimary!,
          fallback: "sans-serif",
          cssVariable: "font-primary",
          googleFontsURL: `https://fonts.googleapis.com/css2?family=${pf}&display=swap`,
        },
        {
          src: [],
          preload: false,
          display: "swap",
          name: fontSecondary!,
          fallback: "sans-serif",
          cssVariable: "font-secondary",
          googleFontsURL: `https://fonts.googleapis.com/css2?family=${sf}&display=swap`,
        },
      ]}
    />

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>{seoTitle}</title>

    <!-- canonical url -->
    <link rel="canonical" href={canonicalUrl} />
    {alternates && <link rel="alternate" hreflang="de-AT" href={`${baseUrl}${alternates.de}`} />}
    {alternates && <link rel="alternate" hreflang="en-AT" href={`${baseUrl}${alternates.en}`} />}
    {alternates && <link rel="alternate" hreflang="x-default" href={`${baseUrl}${alternates.de}`} />}

    <!-- noindex robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta
      name="description"
      content={seoDescription}
    />

    <!-- author from config.json -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- og-title -->
    <meta
      property="og:title"
      content={seoTitle}
    />

    <!-- og-description -->
    <meta
      property="og:description"
      content={seoDescription}
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content={canonicalUrl}
    />
    <meta property="og:site_name" content="enta.at" />
    <meta property="og:locale" content={lang === "en" ? "en_AT" : "de_AT"} />

    <!-- twitter-title -->
    <meta
      name="twitter:title"
      content={seoTitle}
    />

    <!-- twitter-description -->
    <meta
      name="twitter:description"
      content={seoDescription}
    />

    <!-- og-image -->
    <meta
      property="og:image"
      content={socialImage}
    />
    <meta property="og:image:width" content="1730" />
    <meta property="og:image:height" content="909" />
    <meta property="og:image:alt" content="enta.at – AI Automation und vernetzte Workflows" />

    <!-- twitter-image -->
    <meta
      name="twitter:image"
      content={socialImage}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    {serviceSchema && <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />}
  </head>
  <body>
    <a href="#main-content" class="skip-link">{lang === "en" ? "Skip to main content" : "Zum Hauptinhalt springen"}</a>
    <div class="w-full border-b border-slate-200 bg-[#f7f6f4] text-slate-600">
      <div class="container">
        <p data-i18n="site.banner" class="py-2 text-center text-xs font-bold tracking-wide text-slate-600">
          {translations.site.banner}
        </p>
      </div>
    </div>
    <TwSizeIndicator />
    <Header />
    <main id="main-content" class="min-h-[60vh]">
      <slot />
    </main>
    <Footer />
    <script define:vars={{ i18nData: i18n }}>
      (function() {
        const params = new URLSearchParams(window.location.search);

        function getValue(obj, path) {
          return path.split(".").reduce((data, key) => data?.[key], obj);
        }

        function applyTranslation(element, lang) {
          const key = element.dataset.i18n;
          if (!key) return;
          const value = getValue(i18nData[lang], key);
          if (value === undefined || value === null) return;
          if (element.dataset.i18nHtml !== undefined) {
            element.innerHTML = value;
          } else {
            element.textContent = value;
          }
        }

        const routeMap = {
          "/": { de: "/", en: "/" },
          "/automation": { de: "/automation", en: "/automation" },
          "/kontakt": { de: "/kontakt", en: "/contact" },
          "/contact": { de: "/kontakt", en: "/contact" },
          "/privacy-policy": { de: "/privacy-policy", en: "/privacy-policy" },
          "/ressourcen": { de: "/ressourcen", en: "/free-resources" },
          "/free-resources": { de: "/ressourcen", en: "/free-resources" },
          "/services": { de: "/services", en: "/services" },
          "/pricing": { de: "/pricing", en: "/pricing" },
          "/portfolio": { de: "/portfolio", en: "/portfolio" },
          "/impressum": { de: "/impressum", en: "/impressum" },
          "/privacy-policy": { de: "/privacy-policy", en: "/privacy-policy" }
        };

        function normalizePath(path) {
          const raw = path.split("?")[0].trim();
          const trimmed = raw.replace(/\/+$/g, "").replace(/^\s+|\s+$/g, "");
          if (trimmed === "" || trimmed === "/") return "/";
          return trimmed.startsWith("/") ? trimmed : "/" + trimmed;
        }
        function detectLangFromPath(path) {
          const normalized = normalizePath(path);
          if (normalized === "/contact" || normalized === "/free-resources") return "en";
          if (normalized === "/kontakt" || normalized === "/ressourcen") return "de";
          return "de";
        }
        function localizedPath(path, code) {
          return routeMap[normalizePath(path)]?.[code] ?? normalizePath(path);
        }

        function buildLangHref(url, code) {
          const [rawPath, rawQuery] = url.split("?");
          const path = normalizePath(rawPath);
          const target = localizedPath(path, code);
          const params = new URLSearchParams(rawQuery || "");
          params.set("lang", code);
          return target + "?" + params.toString();
        }

        const detectedLang = detectLangFromPath(window.location.pathname);
        let lang = params.get("lang");
        if (!lang || !(lang === "en" || lang === "de")) {
          lang = detectedLang;
        }
        if (!lang) return;

        document.documentElement.lang = lang;
        document.querySelectorAll("[data-i18n]").forEach((element) => applyTranslation(element, lang));

        function updateLanguageSwitcher(lang) {
          document.querySelectorAll("a[data-lang-switcher]").forEach((link) => {
            const href = link.getAttribute("href") || "";
            const url = new URL(href, window.location.origin);
            const code = url.searchParams.get("lang");
            const isActive = code === lang;
            link.className = `text-sm font-semibold transition ${isActive ? "text-primary" : "text-dark/70 hover:text-dark"}`;
            if (isActive) {
              link.setAttribute("aria-current", "page");
            } else {
              link.removeAttribute("aria-current");
            }
          });
        }

        updateLanguageSwitcher(lang);

        document.querySelectorAll("a[href]").forEach((link) => {
          if (link.hasAttribute("data-lang-switcher")) return;
          const href = link.getAttribute("href");
          if (!href || href.startsWith("http") || href.startsWith("mailto:") || href.startsWith("tel:") || href.startsWith("#")) return;
          link.setAttribute("href", buildLangHref(href, lang));
        });

        const title = getValue(i18nData[lang], "meta.title");
        if (title) document.title = title;
        const description = getValue(i18nData[lang], "meta.description");
        if (description) {
          const meta = document.querySelector('meta[name="description"]');
          if (meta) meta.setAttribute("content", description);
        }
      })();
    </script>
  </body>
</html>
