---
import Base from "@/layouts/Base.astro";
import i18n from "@/config/i18n.json";
import { FaRobot, FaPaperclip, FaProjectDiagram } from "react-icons/fa";

type LangCode = "de" | "en";
const urlLang = Astro.url.searchParams.get("lang");
const lang = (urlLang === "en" ? "en" : "de") as LangCode;
const t = i18n[lang];
---

<Base
  title={t.resources.title}
  meta_title="Free n8n Workflows & AI Resources | enta.at"
  description={t.resources.subtitle}
>
  <section class="section border-b border-slate-200 bg-[linear-gradient(180deg,#F7F6F4_0%,#FFFFFF_82%)] pt-20">
    <div class="container">
      <div class="text-center mb-12">
        <span data-i18n="resources.title" class="text-primary text-sm font-semibold uppercase tracking-[0.4em] mb-4 inline-block">
          {t.resources.title}
        </span>
        <h1 data-i18n="resources.title" class="text-4xl font-bold mb-6">{t.resources.title}</h1>
        <p data-i18n="resources.description" class="text-lg text-text-dark/80 max-w-3xl mx-auto">{t.resources.description}</p>
      </div>
      <div class="row gy-6">
        {t.resources.cards.map((card: any, index: number) => (
          <div class="md:col-4">
            <article class="h-full rounded-2xl border border-slate-200 bg-white p-7 transition hover:-translate-y-1 hover:shadow-[0_20px_50px_rgba(15,23,42,.07)]">
              <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-xl bg-red-50 text-2xl text-primary">
                {index === 0 ? <FaProjectDiagram /> : index === 1 ? <FaPaperclip /> : <FaRobot />}
              </div>
              <h2 data-i18n={`resources.cards.${index}.title`} class="text-2xl font-semibold mb-4">{card.title}</h2>
              <p data-i18n={`resources.cards.${index}.description`} class="text-text-dark/80 mb-6">{card.description}</p>
              <a href={card.href} target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary inline-flex items-center justify-center px-6 py-3">
                <span data-i18n="resources.cta">{t.resources.cta}</span>
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
