---
import Base from "@/layouts/Base.astro";
import i18n from "@/config/i18n.json";
import { FaCheckCircle } from "react-icons/fa";

const lang = "de";
const t = i18n[lang];
---

<Base title={t.thank_you.title} description={t.thank_you.subtitle} noindex={true}>
  <section class="section border-b border-slate-200 bg-[linear-gradient(180deg,#F7F6F4_0%,#FFFFFF_82%)] py-20">
    <div class="container">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mx-auto mb-7 flex h-16 w-16 items-center justify-center rounded-2xl bg-primary/10 text-3xl text-primary">
          <FaCheckCircle />
        </div>
        <p class="mb-4 text-sm font-bold uppercase tracking-[0.32em] text-primary">
          ENTA AI Automation
        </p>
        <h1 class="mb-5 text-4xl font-bold leading-tight text-slate-950 md:text-5xl">
          {t.thank_you.title}
        </h1>
        <p class="mb-4 text-xl font-bold text-slate-800">
          {t.thank_you.subtitle}
        </p>
        <p class="mx-auto mb-8 max-w-2xl text-lg leading-8 text-slate-600">
          {t.thank_you.description}
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/?lang=de" class="btn btn-primary px-8 py-3 text-white">
            {t.thank_you.home_cta}
          </a>
          <a href="/automation?lang=de" class="btn btn-outline-primary px-8 py-3">
            {t.thank_you.automation_cta}
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
