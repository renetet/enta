---
import Base from "@/layouts/Base.astro";
import IntegrationStrip from "@/components/IntegrationStrip.astro";
import i18n from "@/config/i18n.json";
import { FaCheck, FaClock, FaProjectDiagram, FaTools } from "react-icons/fa";

const urlLang = Astro.url.searchParams.get("lang");
const lang = urlLang === "en" ? "en" : "de";
const t = i18n[lang];
---

<Base
  title={t.automation.title}
  meta_title={lang === "en" ? "Workflow & AI Automation Vienna | enta.at" : "Workflow- & AI-Automatisierung Wien | enta.at"}
  description={t.automation.paragraph}
>
  <section class="section border-b border-slate-200 bg-[linear-gradient(180deg,#F7F6F4_0%,#FFFFFF_82%)] pt-20">
    <div class="container">
      <div class="grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <span class="text-primary mb-4 inline-block text-sm font-bold uppercase tracking-[0.32em]">
            AI Automatisierungspartner in Wien
          </span>
          <h1 data-i18n="automation.headline" class="mb-6 text-4xl font-bold leading-tight text-slate-950 md:text-5xl">{t.automation.headline}</h1>
          <p data-i18n="automation.paragraph" class="mb-8 text-lg leading-8 text-text-dark/80">{t.automation.paragraph}</p>
          <div class="mb-8 grid gap-3 sm:grid-cols-3">
            {t.automation.points.map((point: string, index: number) => (
              <div class="rounded-xl border border-slate-200 bg-white/80 p-4">
                <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
                  {index === 0 ? <FaProjectDiagram /> : index === 1 ? <FaTools /> : <FaClock />}
                </div>
                <p data-i18n={`automation.points.${index}`} class="text-sm font-bold leading-6 text-slate-800">{point}</p>
              </div>
            ))}
          </div>
          <a href={lang === "en" ? "/contact?lang=en" : "/kontakt?lang=de"} class="btn btn-primary text-white px-8 py-3" data-i18n="automation.cta">
            {t.automation.cta}
          </a>
        </div>
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white p-3 shadow-[0_24px_70px_rgba(15,23,42,0.07)]">
          <img
            src="/images/automation-workshop.png"
            alt="Team designing an automation workflow on a glass board"
            class="h-[390px] w-full rounded-xl object-cover object-center"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white py-14">
    <div class="container">
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.28em] text-primary">
            {lang === "en" ? "Automation stack" : "Automation Stack"}
          </p>
          <h2 class="text-3xl font-bold text-slate-950">
            {lang === "en" ? "Tools connected into one reliable workflow" : "Tools verbunden in einem zuverlässigen Workflow"}
          </h2>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-[#F7F6F4] p-5">
          <IntegrationStrip compact={true} />
        </div>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {[
          lang === "en" ? "Clear process map before implementation" : "Klare Prozesskarte vor der Umsetzung",
          lang === "en" ? "Small, testable workflow modules" : "Kleine, testbare Workflow-Module",
          lang === "en" ? "Handover and optimization after launch" : "Übergabe und Optimierung nach dem Launch",
        ].map((item) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-6 transition hover:-translate-y-1 hover:shadow-[0_20px_50px_rgba(15,23,42,.07)]">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-red-50 text-primary">
              <FaCheck />
            </div>
            <p class="font-bold leading-7 text-slate-800">{item}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
